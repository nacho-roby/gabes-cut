{
  "manifest_version": 3,
  "name": "Gabe's Cut",
  "version": "1.2.0",
  "description": "Estimates sales and revenue for Steam store games using the Boxleiter method (reviews x multiplier).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://gamalytic.com/*"
  ],
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/bg.js"
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/app/*"],
      "js": [
        "lib/calc.js",
        "content/parser.js",
        "content/inject.js"
      ],
      "css": ["content/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
